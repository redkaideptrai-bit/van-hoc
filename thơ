<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sách Thơ Điện Tử - redKAI</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: #1a1818;
      background-image: radial-gradient(#2c2828 1px, transparent 0);
      background-size: 24px 24px;
      font-family: 'Merriweather', serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 12px;
      color: #2c2c2c;
    }

    .book-container {
      width: 100%;
      max-width: 650px;
      position: relative;
    }

    .book {
      width: 100%;
      background: #fbf7f0;
      border-radius: 12px;
      box-shadow: 0 15px 35px rgba(0,0,0,0.6);
      border: 8px solid #3d2b1f;
      padding: 30px 15px 75px 15px; /* Để trống chỗ cho các nút chuyển trang bên dưới */
      position: relative;
      min-height: 80vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .poem-container {
      text-align: center;
      width: 100%;
    }

    .poem-title {
      font-family: 'Dancing Script', cursive;
      font-size: 2.5rem;
      color: #3d2b1f;
      margin-bottom: 25px;
      border-bottom: 1px solid rgba(61, 43, 31, 0.15);
      padding-bottom: 10px;
      display: inline-block;
      width: 80%;
    }

    .poem-content {
      font-size: 1.15rem;
      line-height: 2.2;
      font-style: italic;
      color: #2b2b2b;
      white-space: nowrap; /* Đảm bảo câu thơ chạy hết 1 dòng không tự động rớt xuống */
      word-break: keep-all;
    }

    .poem-author {
      margin-top: 30px;
      font-weight: bold;
      font-style: normal;
      font-size: 1rem;
      color: #8b0000;
    }

    .page-number {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.85rem;
      color: #888;
    }

    /* Định vị nút bấm chuyển trang phía dưới */
    .nav-btn {
      position: absolute;
      bottom: 15px;
      width: 48px;
      height: 48px;
      background: #3d2b1f;
      color: #fbf7f0;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 1.2rem;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      transition: all 0.2s ease;
      z-index: 20;
    }

    .nav-btn:active {
      transform: scale(0.92);
      background: #8b0000;
    }

    .prev-btn { left: 20px; }
    .next-btn { right: 20px; }

    /* Modal báo lỗi Error Code 367 */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.75);
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      z-index: 999;
      padding: 20px;
    }

    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .error-card {
      background: #fff;
      padding: 30px 25px;
      border-radius: 12px;
      text-align: center;
      width: 100%;
      max-width: 350px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
      border-top: 6px solid #e74c3c;
    }

    .error-icon {
      font-size: 2.8rem;
      color: #e74c3c;
      margin-bottom: 12px;
    }

    .error-code {
      font-size: 1rem;
      font-weight: bold;
      color: #7f8c8d;
      margin-bottom: 8px;
      letter-spacing: 1px;
    }

    .error-msg {
      font-size: 1.15rem;
      color: #2c3e50;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .close-btn {
      background: #e74c3c;
      color: white;
      border: none;
      padding: 10px 25px;
      border-radius: 6px;
      font-size: 0.95rem;
      cursor: pointer;
      font-weight: bold;
    }

    /* Tối ưu cho màn hình cực nhỏ */
    @media (max-width: 380px) {
      .poem-content {
        font-size: 0.98rem;
      }
      .poem-title {
        font-size: 2.1rem;
      }
    }
  </style>
</head>
<body>

  <div class="book-container">
    <!-- Khung Trang Sách -->
    <div class="book">
      <div class="poem-container">
        <h2 class="poem-title">Tri Ân Cô</h2>
        <div class="poem-content">
          Mùa thu ôi đẹp rạng ngời,<br>
          Hoa sữa khoe sắc giữa trời thu sang.<br>
          Hương thơm dịu ngọt nhẹ nhàng,<br>
          Như tình cô dạy mênh mang lòng người.<br>
          Chúc cô luôn nở nụ cười,<br>
          Chèo thuyền tri thức, sáng ngời tương lai.
        </div>
        <p class="poem-author">— Tiến Trường (redKAI)</p>
      </div>

      <div class="page-number">Trang 1</div>

      <!-- Nút Chuyển Trang -->
      <button class="nav-btn prev-btn" id="prevBtn">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button class="nav-btn next-btn" id="nextBtn">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <!-- Pop-up Lỗi Code 367 -->
  <div class="modal-overlay" id="errorModal">
    <div class="error-card">
      <div class="error-icon">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div class="error-code">ERROR CODE 367</div>
      <div class="error-msg">Thằng này chưa ra thơ mới</div>
      <button class="close-btn" id="closeBtn">Đóng</button>
    </div>
  </div>

  <script>
    const nextBtn = document.getElementById('nextBtn');
    const prevBtn = document.getElementById('prevBtn');
    const errorModal = document.getElementById('errorModal');
    const closeBtn = document.getElementById('closeBtn');

    nextBtn.addEventListener('click', showError);
    prevBtn.addEventListener('click', showError);

    function showError() {
      errorModal.classList.add('active');
    }

    closeBtn.addEventListener('click', () => {
      errorModal.classList.remove('active');
    });

    errorModal.addEventListener('click', (e) => {
      if (e.target === errorModal) {
        errorModal.classList.remove('active');
      }
    });
  </script>
</body>
</html>
